<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDialogArtNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Artículo"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <TextView
            android:id="@+id/tvDialogArtPrecios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bs. 0.00 ($ 0.00)"
            android:textSize="12.5sp"
            android:textColor="@color/accent_green"
            android:layout_marginTop="2dp" />

        <!-- Bloque exclusivo para Servicio Genérico (Descripción libre e IVA) -->
        <LinearLayout
            android:id="@+id/layoutCamposGenerico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_rounded"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción del Servicio a Vender:"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <EditText
                android:id="@+id/etDialogDescLibre"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/edittext_bg"
                android:hint="Escriba la descripción que desea facturar..."
                android:inputType="textCapSentences"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tipo de IVA para este Servicio:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_main" />

            <RadioGroup
                android:id="@+id/rgDialogIvaGenerico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <RadioButton
                    android:id="@+id/rbGenIva16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="16%"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbGenIva8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="8%"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbGenIva32"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="32%"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbGenIvaExento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Exento"
                    android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Fila horizontal: Cantidad y al lado Precio de Venta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <!-- Columna Cantidad -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cantidad:"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main" />

                <EditText
                    android:id="@+id/etDialogCantidad"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/edittext_bg"
                    android:inputType="number"
                    android:text="1"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Columna Precio de Venta USD (al lado de Cantidad) -->
            <LinearLayout
                android:id="@+id/layoutColPrecioUSD"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/tvLabelPrecioVentaUSD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precio Venta ($):"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <EditText
                    android:id="@+id/etDialogPrecioVentaUSD"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/edittext_bg"
                    android:inputType="numberDecimal"
                    android:hint="0.00"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Columna Precio de Venta Bs. (al lado) -->
            <LinearLayout
                android:id="@+id/layoutColPrecioBs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLabelPrecioVentaBs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precio Venta (Bs.):"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <EditText
                    android:id="@+id/etDialogPrecioVentaBs"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/edittext_bg"
                    android:inputType="numberDecimal"
                    android:hint="0.00"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAvisoEdicionPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Precio fijo de catálogo (Edición desactivada en Configuración)"
            android:textSize="11sp"
            android:textColor="@color/text_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnDialogConfirmarAgregar"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/button_primary"
                android:text="AGREGAR A FACTURA"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDialogCancelarCantidad"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="18dp"
                android:background="@drawable/button_danger"
                android:text="CANCELAR"
                android:textColor="#DC2626"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
