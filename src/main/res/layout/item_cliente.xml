<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvClienteNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del Cliente C.A."
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <TextView
            android:id="@+id/tvClienteRif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RIF: J-00000000-0"
            android:textSize="13sp"
            android:textColor="@color/accent_blue"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvClienteTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tel: 0414-0000000"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvClienteDireccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dirección"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>