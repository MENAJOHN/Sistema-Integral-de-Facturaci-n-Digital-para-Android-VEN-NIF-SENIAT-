<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivVendedorFoto"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:scaleType="centerCrop"
            android:src="@drawable/app_logo"
            android:background="@drawable/card_rounded"
            android:padding="2dp"
            android:contentDescription="Foto Vendedor" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvVendedorNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="John Mena"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_main" />

            <TextView
                android:id="@+id/tvVendedorCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Código: VEN-001 | C.I.: V-12345678"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvVendedorDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dirección: Caracas"
                android:textSize="12sp"
                android:textColor="@color/text_main"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvVendedorTelefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tel: 0424-1958013"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvVendedorComision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comisión: 5%"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent_green"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
