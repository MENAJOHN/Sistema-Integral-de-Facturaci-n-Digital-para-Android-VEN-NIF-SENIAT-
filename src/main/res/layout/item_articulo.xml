<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivArticuloFoto"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:src="@drawable/app_logo"
            android:background="@drawable/card_rounded"
            android:contentDescription="Foto Artículo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvArticuloCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ART-001"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue" />

            <TextView
                android:id="@+id/tvArticuloDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción del Artículo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:maxLines="2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvArticuloPrecioBs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bs. 0.00"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tvArticuloPrecioUSD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="($ 0.00)"
                    android:textSize="12sp"
                    android:textColor="@color/accent_green" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvArticuloStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock: 10"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>